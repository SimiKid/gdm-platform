# ── Synapse ──────────────────────────────────────────
SYNAPSE_SERVER_NAME=localhost
SYNAPSE_REPORT_STATS=no
SYNAPSE_HTTP_PORT=8010

# ── Synapse Postgres ─────────────────────────────────
SYNAPSE_DB_NAME=synapse
SYNAPSE_DB_USER=synapse
SYNAPSE_DB_PASSWORD=synapse_secret

# ── Research Postgres ─────────────────────────────────
RESEARCH_DB_NAME=gdm_research
RESEARCH_DB_USER=gdm
RESEARCH_DB_PASSWORD=gdm_secret

# Host-machine connection string for local Prisma commands.
DATABASE_URL=postgresql://gdm:gdm_secret@localhost:5433/gdm_research?schema=public

# ── Signing key (auto-generated on first run) ────────
SYNAPSE_SIGNING_KEY_PATH=/data/localhost.signing.key

# ── App service URLs ─────────────────────────────────
# Browser-facing Matrix URL returned to participants by Session Manager.
# For Docker Compose local use, participant nginx proxies /_matrix on :3000.
MATRIX_PUBLIC_URL=http://localhost:3000
