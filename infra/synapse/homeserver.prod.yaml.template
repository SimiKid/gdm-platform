## GDM Study Platform – Synapse Production Configuration TEMPLATE
##
## Rendered by infra/render-homeserver.sh, which substitutes the ${VAR}
## placeholders from infra/.env into homeserver.prod.yaml (gitignored).
## Synapse itself cannot read environment variables, so secrets land in the
## rendered file on the server only — never commit that file.
##
## IMPORTANT: server_name is baked into every Matrix user ID and the signing
## key on first startup and can NEVER be changed afterwards. Verify it before
## the very first `docker compose up` on the production host.

server_name: "${SYNAPSE_SERVER_NAME}"
public_baseurl: "${MATRIX_PUBLIC_URL}"
pid_file: /data/homeserver.pid
report_stats: false

listeners:
  - port: 8008
    tls: false
    type: http
    x_forwarded: true
    resources:
      # The study is local-only; exposing federation adds an unnecessary
      # unauthenticated protocol surface and no participant functionality.
      - names: [client]
        compress: false

# ── Database ──────────────────────────────────────────
database:
  name: psycopg2
  args:
    user: ${SYNAPSE_DB_USER}
    password: ${SYNAPSE_DB_PASSWORD}
    database: ${SYNAPSE_DB_NAME}
    host: synapse-db
    port: 5432
    cp_min: 5
    cp_max: 10

# ── Logging ───────────────────────────────────────────
log_config: "/data/log.config"

# ── Media store ───────────────────────────────────────
media_store_path: /data/media_store

# ── Registration ──────────────────────────────────────
# Registration stays enabled because the Session Manager registers participant
# accounts server-side via the internal Docker network (MATRIX_INTERNAL_URL).
# The public reverse proxy MUST NOT forward /_matrix/client/*/register, so
# this endpoint is unreachable from the internet.
enable_registration: true
enable_registration_without_verification: true

# ── Signing key ───────────────────────────────────────
signing_key_path: "/data/${SYNAPSE_SERVER_NAME}.signing.key"

# ── Trusted key servers (federation disabled above) ───
trusted_key_servers: []
suppress_key_server_warning: true

# ── Room defaults ─────────────────────────────────────
# Disable encryption by default so study rooms stay readable
encryption_enabled_by_default_for_room_type: "off"

# ── Application services (Bot / Rule Engine) ──────────
# STUB: uncomment when the bot appservice lands (see docker-compose.yml).
# app_service_config_files:
#   - /data/appservice-registration.yaml

# ── Rate limiting (relaxed for study sessions) ────────
rc_message:
  per_second: 10
  burst_count: 50

rc_login:
  address:
    per_second: 5
    burst_count: 20
  account:
    per_second: 5
    burst_count: 20

# Participant accounts all arrive from the Session Manager's one Docker IP.
# Size the bucket for the largest benchmark wave; Caddy blocks this API from
# the internet, so only the internal service can use the relaxed rate.
rc_registration:
  per_second: 50
  burst_count: 300

# Every group needs a private room created by the same internal orchestrator.
# Synapse's default (burst 10, then roughly one room/minute) cannot support a
# study recruitment wave. A 249-person run creates up to 83 rooms.
rc_room_creation:
  per_second: 5
  burst_count: 100

# The same service bot is invited into every study room. Synapse's default
# recipient limit allows only five rapid invites and then blocks new groups
# for several minutes. Public registration is blocked by Caddy and study
# rooms reserve invitation power for the orchestrator. The issuer burst covers
# one 249-person wave (participants + recorder bots) without retries.
rc_invites:
  per_room:
    per_second: 10
    burst_count: 50
  per_user:
    per_second: 20
    burst_count: 100
  per_issuer:
    per_second: 50
    # 249 participants + primary recorder + both comparison bots = 498.
    burst_count: 600

# The primary recorder (and, in comparison mode, each named bot) joins one
# room per group. Synapse's default per-account burst of 10 would throttle the
# recorder after only 30 participants; 249 participants need up to 83 joins.
rc_joins:
  local:
    per_second: 25
    burst_count: 100
  # No remote rooms are part of the study, so keep the conservative default.
  remote:
    per_second: 0.01
    burst_count: 10
