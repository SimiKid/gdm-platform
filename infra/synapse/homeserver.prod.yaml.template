## GDM Study Platform – Synapse Production Configuration TEMPLATE
##
## Rendered by infra/render-homeserver.sh, which substitutes the ${VAR}
## placeholders from infra/.env into homeserver.prod.yaml (gitignored).
## Synapse itself cannot read environment variables, so secrets land in the
## rendered file on the server only — never commit that file.
##
## IMPORTANT: server_name is baked into every Matrix user ID and the signing
## key on first startup and can NEVER be changed afterwards. Verify it before
## the very first `docker compose up` on the production host.

server_name: "${SYNAPSE_SERVER_NAME}"
public_baseurl: "${MATRIX_PUBLIC_URL}"
pid_file: /data/homeserver.pid
report_stats: false

listeners:
  - port: 8008
    tls: false
    type: http
    x_forwarded: true
    resources:
      - names: [client, federation]
        compress: false

# ── Database ──────────────────────────────────────────
database:
  name: psycopg2
  args:
    user: ${SYNAPSE_DB_USER}
    password: ${SYNAPSE_DB_PASSWORD}
    database: ${SYNAPSE_DB_NAME}
    host: synapse-db
    port: 5432
    cp_min: 5
    cp_max: 10

# ── Logging ───────────────────────────────────────────
log_config: "/data/log.config"

# ── Media store ───────────────────────────────────────
media_store_path: /data/media_store

# ── Registration ──────────────────────────────────────
# Registration stays enabled because the Session Manager registers participant
# accounts server-side via the internal Docker network (MATRIX_INTERNAL_URL).
# The public reverse proxy MUST NOT forward /_matrix/client/*/register, so
# this endpoint is unreachable from the internet.
enable_registration: true
enable_registration_without_verification: true

# ── Signing key ───────────────────────────────────────
signing_key_path: "/data/${SYNAPSE_SERVER_NAME}.signing.key"

# ── Trusted key servers (no federation partners) ──────
trusted_key_servers: []
suppress_key_server_warning: true

# ── Room defaults ─────────────────────────────────────
# Disable encryption by default so study rooms stay readable
encryption_enabled_by_default_for_room_type: "off"

# ── Application services (Bot / Rule Engine) ──────────
# STUB: uncomment when the bot appservice lands (see docker-compose.yml).
# app_service_config_files:
#   - /data/appservice-registration.yaml

# ── Rate limiting (relaxed for study sessions) ────────
rc_message:
  per_second: 10
  burst_count: 50

rc_login:
  address:
    per_second: 5
    burst_count: 20
  account:
    per_second: 5
    burst_count: 20

# Participants register in bursts when a group forms; relax the default
# (0.17/s, burst 3) so simultaneous joins don't hit M_LIMIT_EXCEEDED.
rc_registration:
  per_second: 5
  burst_count: 30
