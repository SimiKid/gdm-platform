# Copy to infra/.env and adjust. start.sh does the copy automatically.
# For a real study run, replace every *_PASSWORD / *_TOKEN value.
#
# PRODUCTION: set GDM_ENV=production, SYNAPSE_SERVER_NAME to the real host,
# both public URLs to https://<host>, fresh passwords, and both API tokens.
# The backends refuse to start in production with the dev defaults below.
# NOTE: the git history contains the old dev passwords — never reuse them.

# ── Environment ──────────────────────────────────────
# "production" makes the backends fail fast on missing tokens/URLs.
GDM_ENV=development

# ── Synapse ──────────────────────────────────────────
# IMMUTABLE after Synapse's first start (baked into user IDs + signing key).
# Production: gdmproject.ifi.uzh.ch — set BEFORE the first `compose up`.
SYNAPSE_SERVER_NAME=localhost
SYNAPSE_REPORT_STATS=no
SYNAPSE_HTTP_PORT=8010

# Production only: render homeserver.prod.yaml from the template after every
# change to the SYNAPSE_* values (Synapse cannot read env vars itself):
#   sh infra/render-homeserver.sh

# ── Synapse Postgres ─────────────────────────────────
SYNAPSE_DB_NAME=synapse
SYNAPSE_DB_USER=synapse
SYNAPSE_DB_PASSWORD=synapse_secret

# ── Research Postgres ─────────────────────────────────
RESEARCH_DB_NAME=gdm_research
RESEARCH_DB_USER=gdm
RESEARCH_DB_PASSWORD=gdm_secret

# Host-machine connection string for local Prisma commands.
DATABASE_URL=postgresql://gdm:gdm_secret@localhost:5433/gdm_research?schema=public

# ── Signing key (auto-generated on first run) ────────
SYNAPSE_SIGNING_KEY_PATH=/data/localhost.signing.key

# ── App service URLs ─────────────────────────────────
# Browser-facing Matrix URL returned to participants by Session Manager.
# For Docker Compose local use, participant nginx proxies /_matrix on :3000.
# Production: https://gdmproject.ifi.uzh.ch
MATRIX_PUBLIC_URL=http://localhost:3000
# Absolute URL participants use to reach the study (recruiting link shown in
# the admin dashboard). Baked into the dashboard image at build time.
# Production: https://gdmproject.ifi.uzh.ch
PARTICIPANT_PUBLIC_URL=http://localhost:3000

# ── API protection ───────────────────────────────────
# Researcher endpoints (dashboard, exports). Empty = unprotected (dev only).
# Production: required — generate with `openssl rand -hex 32`.
ADMIN_API_TOKEN=
# Shared secret between Session Manager and Chat Service. Empty = unprotected.
# Production: required — generate with `openssl rand -hex 32`.
INTERNAL_API_TOKEN=
# Waiting groups older than this are aborted so no-shows free their slots.
WAITING_TIMEOUT_MINUTES=30
