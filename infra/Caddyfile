# Public entry point for the study platform. TLS certificates come from
# Let's Encrypt automatically (requires ports 80+443 reachable from the
# internet). PUBLIC_HOST and ACME_EMAIL are injected via docker-compose.prod.yml.
{
	email {$ACME_EMAIL}
}

{$PUBLIC_HOST} {
	handle /_matrix/* {
		# Participant accounts are registered server-side by the Session
		# Manager over the internal Docker network — Matrix registration must
		# never be reachable from the internet (homeserver.yaml keeps it
		# enabled). The matcher must live INSIDE this handle block: a
		# top-level respond sorts after handle in Caddy's directive order
		# and would never run for /_matrix/* requests.
		@register path_regexp ^/_matrix/client/[^/]+/register
		respond @register 403

		reverse_proxy synapse:8008
	}

	handle /api/* {
		reverse_proxy session-manager:3001
	}

	# Temporary researcher access on the existing public host. The dashboard
	# itself contains no research data; every researcher API request remains
	# protected by ADMIN_API_TOKEN in the Session Manager. Keep the localhost
	# port binding below as an SSH-tunnel fallback.
	redir /admin /admin/ 308
	handle_path /admin/* {
		reverse_proxy admin-dashboard:80
	}

	# Everything else is the participant SPA (its nginx serves the static build).
	handle {
		reverse_proxy participant:80
	}
}
