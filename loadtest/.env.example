# Target and production safety.
LOADTEST_BASE_URL=https://gdmproject.ifi.uzh.ch
LOADTEST_SSH_TARGET=masterproject
LOADTEST_ADMIN_TOKEN=

# Required only for the real production hostname above. This deliberate value
# prevents an accidental high-load run after merely copying this file.
LOADTEST_CONFIRM_PRODUCTION=

# Tooling. A local k6 binary is used when available; otherwise this image runs.
LOADTEST_K6_IMAGE=grafana/k6:1.7.1

# Test behavior.
LOADTEST_PROFILE=smoke
LOADTEST_GROUP_SIZE=3
LOADTEST_SESSION_MINUTES=120
LOADTEST_SYNC_TIMEOUT_MS=5000
LOADTEST_MESSAGE_MIN_SECONDS=20
LOADTEST_MESSAGE_MAX_SECONDS=45
LOADTEST_CURSOR_SECONDS=10
LOADTEST_RANKING_MIN_SECONDS=60
LOADTEST_RANKING_MAX_SECONDS=120
LOADTEST_REACTION_MIN_SECONDS=45
LOADTEST_REACTION_MAX_SECONDS=120

# Monitoring and optional real-browser canary.
LOADTEST_MONITOR=1
LOADTEST_MONITOR_INTERVAL_SECONDS=5
LOADTEST_OPEN_DASHBOARD=1
LOADTEST_BROWSER_CANARY=0
LOADTEST_CANARY_INTERVAL_SECONDS=600
LOADTEST_CANARY_INITIAL_DELAY_SECONDS=120

# Initial service-level objectives. Override after agreeing final study SLOs.
LOADTEST_SLO_SEND_P95_MS=750
LOADTEST_SLO_SEND_P99_MS=2000
LOADTEST_SLO_PEER_P95_MS=1500
LOADTEST_SLO_PEER_P99_MS=3000
LOADTEST_SLO_API_P95_MS=1000
LOADTEST_SLO_SESSION_OPEN_P95_MS=5000
LOADTEST_SLO_GROUP_READY_P95_MS=15000
LOADTEST_SLO_FAILURE_RATE=0.01
