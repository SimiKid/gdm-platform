{
  "name": "session-manager",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "prisma generate --schema prisma/schema.prisma && nest build",
    "db:deploy": "prisma migrate deploy --schema prisma/schema.prisma",
    "db:generate": "prisma generate --schema prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema prisma/schema.prisma",
    "db:studio": "prisma studio --schema prisma/schema.prisma",
    "dev": "nest start --watch",
    "start": "node dist/main",
    "lint": "oxlint",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "test:integration": "prisma generate --schema prisma/schema.prisma && vitest run --config vitest.config.integration.ts"
  },
  "dependencies": {
    "@gdm/shared": "workspace:*",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@prisma/client": "^6.19.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.1.27",
    "@swc/core": "^1.15.43",
    "@testcontainers/postgresql": "^12.0.4",
    "@types/node": "^24.13.2",
    "@types/supertest": "^7.2.0",
    "@vitest/coverage-v8": "^3.2.4",
    "prisma": "^6.19.0",
    "supertest": "^7.2.2",
    "typescript": "~6.0.2",
    "unplugin-swc": "^1.5.9",
    "vitest": "^3.2.4"
  }
}
