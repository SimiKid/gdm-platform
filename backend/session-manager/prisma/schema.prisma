generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ConditionRecord {
  id              String          @id
  name            String
  active          Boolean         @default(true)
  goal            Int
  durationMinutes Int             @map("duration_minutes")
  groupSize       Int             @map("group_size")
  config          Json
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")
  sessions        SessionRecord[]

  @@map("conditions")
}

// The study runs in numbered rounds; sessions are stamped with the round
// open at their creation. NOTE: the migration adds a partial unique index
// ("study_rounds_one_open_idx") enforcing exactly one open round
// (ended_at IS NULL) — Prisma cannot express it, do not let a future
// `migrate dev` drop it.
model StudyRoundRecord {
  id        Int             @id
  label     String          @default("")
  startedAt DateTime        @default(now()) @map("started_at")
  endedAt   DateTime?       @map("ended_at")
  sessions  SessionRecord[]

  @@map("study_rounds")
}

model SessionRecord {
  id                     String                   @id
  status                 String
  conditionId            String                   @map("condition_id")
  roundId                Int                      @default(1) @map("round_id")
  conditionSnapshot      Json                     @map("condition_snapshot")
  bot                    Json
  briefing               Json
  rankingTask            Json                     @map("ranking_task")
  ranking                Json
  polls                  Json
  behavioralEvents       Json                     @default("[]") @map("behavioral_events")
  classifications        Json                     @default("[]") @map("contribution_classifications")
  classificationFailures Json                     @default("[]") @map("classification_failures")
  processedEventIds      Json                     @default("[]") @map("processed_event_ids")
  runtimeState           Json                     @default("{}") @map("runtime_state")
  checkpointRevision     Int                      @default(0) @map("checkpoint_revision")
  durationMinutes        Int                      @map("duration_minutes")
  roomId                 String?                  @map("room_id")
  createdAt              DateTime                 @default(now()) @map("created_at")
  startedAt              DateTime?                @map("started_at")
  completedAt            DateTime?                @map("completed_at")
  waitingDeadlineAt      DateTime?                @map("waiting_deadline_at")
  condition              ConditionRecord          @relation(fields: [conditionId], references: [id])
  round                  StudyRoundRecord         @relation(fields: [roundId], references: [id])
  participants           ParticipantRecord[]
  messages               MessageRecord[]
  rankingHistory         RankingHistoryRecord[]
  interventions          InterventionRecord[]
  windowEvaluations      WindowEvaluationRecord[]

  @@index([conditionId])
  @@index([roundId])
  @@index([status])
  @@index([createdAt])
  @@map("sessions")
}

model ParticipantRecord {
  id                String         @id
  sessionId         String         @map("session_id")
  name              String
  trackingToken     String         @map("tracking_token")
  prolificPid       String?        @map("prolific_pid")
  prolificStudyId   String?        @map("prolific_study_id")
  prolificSessionId String?        @map("prolific_session_id")
  completedAt       DateTime?      @map("completed_at")
  matrixUserId      String?        @map("matrix_user_id")
  matrixAccessToken String?        @map("matrix_access_token")
  createdAt         DateTime       @default(now()) @map("created_at")
  session           SessionRecord  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  surveys           SurveyRecord[]

  @@unique([prolificStudyId, prolificSessionId])
  @@index([sessionId])
  @@index([trackingToken])
  @@index([prolificPid])
  @@map("participants")
}

model ProlificArrivalRecord {
  id                      String                      @id @default(uuid())
  prolificPid             String                      @map("prolific_pid")
  prolificStudyId         String                      @map("prolific_study_id")
  prolificSessionId       String                      @map("prolific_session_id")
  participantRecordId     String?                     @map("participant_record_id")
  arrivedAt               DateTime                    @default(now()) @map("arrived_at")
  stage                   String                      @default("arrived")
  stageUpdatedAt          DateTime                    @default(now()) @map("stage_updated_at")
  lastSeenAt              DateTime                    @default(now()) @map("last_seen_at")
  outcome                 String?
  outcomeReason           String?                     @map("outcome_reason")
  endedAt                 DateTime?                   @map("ended_at")
  elapsedSeconds          Int?                        @map("elapsed_seconds")
  compensationKind        String?                     @map("compensation_kind")
  compensationAmountPence Int?                        @map("compensation_amount_pence")
  events                  ParticipationEventRecord[]
  compensation            ProlificCompensationRecord?

  @@unique([prolificStudyId, prolificSessionId])
  @@index([prolificPid])
  @@index([stage])
  @@index([outcome])
  @@index([outcome, lastSeenAt])
  @@map("prolific_arrivals")
}

model ParticipationEventRecord {
  id                String                @id @default(uuid())
  prolificArrivalId String                @map("prolific_arrival_id")
  type              String
  stage             String
  detail            Json                  @default("{}")
  occurredAt        DateTime              @default(now()) @map("occurred_at")
  arrival           ProlificArrivalRecord @relation(fields: [prolificArrivalId], references: [id], onDelete: Cascade)

  @@index([prolificArrivalId, occurredAt])
  @@map("participation_events")
}

model ProlificCompensationRecord {
  id                 String                @id @default(uuid())
  prolificArrivalId  String                @unique @map("prolific_arrival_id")
  kind               String
  amountPence        Int?                  @map("amount_pence")
  currency           String                @default("GBP")
  status             String                @default("pending")
  returnRequestedAt  DateTime?             @map("return_requested_at")
  bonusBatchId       String?               @map("bonus_batch_id")
  paymentSubmittedAt DateTime?             @map("payment_submitted_at")
  actionError        String?               @map("action_error")
  attemptCount       Int                   @default(0) @map("attempt_count")
  nextAttemptAt      DateTime?             @map("next_attempt_at")
  createdAt          DateTime              @default(now()) @map("created_at")
  updatedAt          DateTime              @updatedAt @map("updated_at")
  arrival            ProlificArrivalRecord @relation(fields: [prolificArrivalId], references: [id], onDelete: Cascade)

  @@index([status, nextAttemptAt])
  @@map("prolific_compensations")
}

model SurveyRecord {
  id            String            @id @default(uuid())
  participantId String            @map("participant_id")
  kind          String
  answers       Json
  submittedAt   DateTime          @map("submitted_at")
  participant   ParticipantRecord @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@unique([participantId, kind])
  @@index([kind])
  @@map("surveys")
}

model MessageRecord {
  id          String           @id
  sessionId   String           @map("session_id")
  timestamp   DateTime
  senderId    String           @map("sender_id")
  recipientId String?          @map("recipient_id")
  text        String
  session     SessionRecord    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  reactions   ReactionRecord[]

  @@index([sessionId, timestamp])
  @@map("messages")
}

model ReactionRecord {
  id               String        @id @default(uuid())
  messageId        String        @map("message_id")
  eventId          String?       @unique @map("event_id")
  key              String
  senderId         String        @map("sender_id")
  timestamp        DateTime
  redacted         Boolean       @default(false)
  redactionEventId String?       @map("redaction_event_id")
  redactedAt       DateTime?     @map("redacted_at")
  message          MessageRecord @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId, redacted])
  @@map("reactions")
}

model RankingHistoryRecord {
  id        String        @id @default(uuid())
  sessionId String        @map("session_id")
  position  Int
  ranking   Json
  updatedAt DateTime      @map("updated_at")
  session   SessionRecord @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, position])
  @@index([sessionId])
  @@map("ranking_history")
}

model InterventionRecord {
  id                        String        @id
  sessionId                 String        @map("session_id")
  roomId                    String        @map("room_id")
  conditionId               String        @map("condition_id")
  mode                      String
  audience                  String
  timestamp                 DateTime
  trigger                   String
  threshold                 Float
  contributionWindowMinutes Int           @map("contribution_window_minutes")
  message                   String
  payload                   Json
  session                   SessionRecord @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([conditionId])
  @@index([timestamp])
  @@map("interventions")
}

model WindowEvaluationRecord {
  id          String        @id
  sessionId   String        @map("session_id")
  conditionId String        @map("condition_id")
  arm         String
  windowIndex Int           @map("window_index")
  windowStart DateTime      @map("window_start")
  windowEnd   DateTime      @map("window_end")
  outcome     String
  llmMode     String        @map("llm_mode")
  payload     Json
  session     SessionRecord @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([conditionId])
  @@index([outcome])
  @@map("window_evaluations")
}

model StudySettingRecord {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("study_settings")
}
