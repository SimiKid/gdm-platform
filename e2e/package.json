{
  "name": "@gdm/e2e",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "test:e2e": "playwright test",
    "test:e2e:list": "playwright test --list",
    "test:e2e:live": "E2E_LIVE_ANTHROPIC=1 playwright test tests/llm-live.spec.ts",
    "test:e2e:recovery": "E2E_ALLOW_SERVICE_RESTART=1 playwright test tests/recovery.spec.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "^24.13.2"
  }
}
